# 复制本文件为 .env 后填入你自己的配置（.env 已被 .gitignore 排除，不会提交）

# API Key（必填才能使用 AI 功能；也兼容 DEEPSEEK_KEY / DASHSCOPE_API_KEY）
IME_AI_KEY=your-api-key-here

# 以下留空/删除则使用默认值（与 dovahwall.cn 线上同款）
# IME_AI_BASE_URL=https://api.deepseek.com/v1
# IME_AI_MODEL=deepseek-chat
# IME_AI_TIMEOUT=15

# 服务监听
# IME_HOST=127.0.0.1
# IME_PORT=8000
